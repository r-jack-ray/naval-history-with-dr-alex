{
  "name": "naval-history-with-dr-alex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Static reference archive tooling for Dr. Alex Clarke's naval history videos.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.json",
    "check:types": "tsc --noEmit -p tsconfig.json",
    "test": "npm run check:types && node --import tsx --test \"src/**/*.test.ts\"",
    "check:source": "npm run audit:topic-normalization && npm run check:video-topics && npm run audit:site-content",
    "check": "npm test && npm run check:source && npm run site:check",
    "check:production": "npm run check:rendered-site && npm run check:search-ranking",
    "check:ci": "npm test && npm run site:build && npm run check:production",
    "report:video-segment-audit-risk": "tsx src/scripts/rank-video-segment-audit-risk.ts",
    "report:video-topic-usage": "bun run src/scripts/report-video-topic-usage-bun.ts",
    "report:transcript-problems": "tsx src/scripts/report-transcript-problems.ts",
    "audit:site-content": "node src/scripts/site-content-pipeline-lock.mjs run --purpose site-content-audit -- node --import tsx src/scripts/audit-site-content.ts",
    "diagnose:site-content-duplicates": "tsx src/scripts/diagnose-site-content-duplicates.ts",
    "sync:video-topics": "node src/scripts/site-content-pipeline-lock.mjs run --purpose video-topic-sync --recover-stale -- bun run src/scripts/sync-video-topics-bun.ts",
    "check:video-topics": "bun run src/scripts/check-video-topics-bun.ts",
    "audit:topic-normalization": "bun run src/scripts/audit-topic-normalization-bun.ts",
    "audit:transcript-schedules": "tsx src/scripts/audit-transcript-schedules.ts",
    "audit:video-timestamp-alignment": "tsx src/scripts/audit-video-timestamp-alignment.ts",
    "fetch:video-links": "tsx src/scripts/get-channel-video-links.ts --api-key-file .local/youtube-api-key.txt",
    "fetch:video-metadata": "tsx src/scripts/fetch-video-metadata.ts --api-key-file .local/youtube-api-key.txt",
    "alternate:extract:saved-channel-html": "tsx src/scripts/extract-saved-channel-html.ts",
    "alternate:merge:video-links": "tsx src/scripts/merge-channel-video-links.ts",
    "alternate:fetch:transcripts": "tsx src/scripts/fetch-transcript-batch.ts",
    "alternate:fetch:transcripts:safe": "tsx src/scripts/fetch-transcript-batch.ts --request-delay-ms 60000",
    "generate:site-data": "node --env-file=site-build.properties src/scripts/site-content-pipeline-lock.mjs run --purpose site-archive-generation --recover-stale -- bun run src/scripts/generate-site-data-bun.ts",
    "site:dev": "node --env-file=site-build.properties src/scripts/site-dev.mjs",
    "site:preview": "node --env-file=site-build.properties node_modules/astro/bin/astro.mjs preview",
    "site:check": "npm run generate:site-data && npm run site:check:generated",
    "site:check:generated": "node --env-file=site-build.properties node_modules/astro/bin/astro.mjs check --tsconfig tsconfig.astro.json",
    "site:build": "node --env-file=site-build.properties src/scripts/site-build-if-changed.mjs --generate",
    "site:build:generated": "node --env-file=site-build.properties src/scripts/site-build-if-changed.mjs",
    "site:build:astro": "node --env-file=site-build.properties node_modules/astro/bin/astro.mjs build --silent",
    "site:build:pagefind": "node --env-file=site-build.properties node_modules/pagefind/lib/runner/bin.cjs --site site/dist --glob \"**/index.html\"",
    "site:build:pagefind:workspace": "node src/scripts/run-workspace-pagefind.mjs",
    "site:build:workspace-pagefind": "node --env-file=site-build.properties src/scripts/site-build-if-changed.mjs --generate --workspace-pagefind",
    "check:workspace-pagefind": "npm run site:build:workspace-pagefind && npm run check:pagefind-contract && npm run check:search-ranking && npm run check:rendered-video-dates",
    "check:pagefind-contract": "tsx src/scripts/check-pagefind-contract.ts",
    "check:search-ranking": "tsx src/scripts/check-search-ranking.ts",
    "check:rendered-video-dates": "tsx src/scripts/check-rendered-video-dates.ts",
    "check:rendered-site": "node --env-file=site-build.properties --import tsx src/scripts/check-rendered-site.ts",
    "check:site-seo": "node --env-file=site-build.properties --import tsx src/scripts/check-site-seo.ts",
    "audit:lighthouse": "tsx src/scripts/audit-seo-lighthouse.ts"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.3",
    "@types/node": "^22.20.1",
    "astro": "^7.2.0",
    "htmlparser2": "^12.0.0",
    "lighthouse": "^13.4.1",
    "pagefind": "^1.5.2",
    "puppeteer-core": "^25.5.0",
    "saxes": "^6.0.0",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "youtube-transcript-plus": "^2.0.1",
    "zod": "^4.4.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
