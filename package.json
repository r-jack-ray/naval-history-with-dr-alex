{
  "name": "naval-history-with-dr-alex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Static reference archive tooling for Dr. Alex Clarke's naval history videos.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.json",
    "check:types": "tsc --noEmit -p tsconfig.json",
    "test": "npm run clean && npm run build && node --test \"dist/**/*.test.js\"",
    "check:source": "npm run audit:topic-normalization && npm run check:video-topics && npm run audit:site-content && npm run report:video-topic-usage",
    "check:generated": "npm run site:check",
    "check": "npm run check:types && npm test && npm run check:source && npm run check:generated",
    "check:production": "npm run site:build:generated && npm run check:site-seo:built && npm run check:search-ranking && npm run check:rendered-video-dates",
    "check:repository-policy": "node .codex/hooks/check-repository-policy.mjs",
    "check:ci": "npm run check && npm run check:production && npm run check:repository-policy",
    "report:video-segment-audit-risk": "tsx src/scripts/rank-video-segment-audit-risk.ts",
    "report:video-topic-usage": "bun run src/scripts/report-video-topic-usage-bun.ts",
    "report:transcript-problems": "tsx src/scripts/report-transcript-problems.ts",
    "audit:site-content": "node .codex/hooks/site-content-pipeline-lock.mjs run --purpose site-content-audit -- node --import tsx src/scripts/audit-site-content.ts",
    "diagnose:site-content-duplicates": "tsx src/scripts/diagnose-site-content-duplicates.ts",
    "sync:video-topics": "node .codex/hooks/site-content-pipeline-lock.mjs run --purpose video-topic-sync --recover-stale -- bun run src/scripts/sync-video-topics-bun.ts",
    "check:video-topics": "bun run src/scripts/check-video-topics-bun.ts",
    "audit:topic-normalization": "bun run src/scripts/audit-topic-normalization-bun.ts",
    "append:site-content-processing-log": "node .codex/hooks/site-content-pipeline-lock.mjs append-log",
    "audit:transcript-schedules": "tsx src/scripts/audit-transcript-schedules.ts",
    "audit:video-timestamp-alignment": "tsx src/scripts/audit-video-timestamp-alignment.ts",
    "fetch:video-links": "tsx src/scripts/get-channel-video-links.ts --api-key-file .local/youtube-api-key.txt",
    "fetch:video-metadata": "tsx src/scripts/fetch-video-metadata.ts --api-key-file .local/youtube-api-key.txt",
    "alternate:extract:saved-channel-html": "tsx src/scripts/extract-saved-channel-html.ts",
    "alternate:extract:live-streams-html": "tsx src/scripts/extract-live-streams-html.ts",
    "alternate:merge:video-links": "tsx src/scripts/merge-channel-video-links.ts",
    "alternate:fetch:transcript": "tsx src/scripts/get-video-transcript.ts",
    "alternate:fetch:transcripts": "tsx src/scripts/fetch-transcript-batch.ts",
    "alternate:fetch:transcripts:safe": "tsx src/scripts/fetch-transcript-batch.ts --request-delay-ms 60000 --retry-failed",
    "generate:site-data": "node --env-file=site-build.properties .codex/hooks/site-content-pipeline-lock.mjs run --purpose site-archive-generation --recover-stale -- bun run src/scripts/generate-site-data-bun.ts",
    "site:dev": "node --env-file=site-build.properties .codex/hooks/site-dev.mjs",
    "site:dev:generated": "node --env-file=site-build.properties node_modules/astro/bin/astro.mjs dev",
    "site:preview": "node --env-file=site-build.properties node_modules/astro/bin/astro.mjs preview",
    "site:check": "npm run generate:site-data && npm run site:check:generated",
    "site:check:generated": "node --env-file=site-build.properties node_modules/astro/bin/astro.mjs check --tsconfig tsconfig.astro.json",
    "site:build": "node --env-file=site-build.properties .codex/hooks/site-build-if-changed.mjs --generate",
    "site:build:generated": "node --env-file=site-build.properties .codex/hooks/site-build-if-changed.mjs",
    "site:build:astro": "node --env-file=site-build.properties node_modules/astro/bin/astro.mjs build --silent",
    "site:build:pagefind": "node --env-file=site-build.properties node_modules/pagefind/lib/runner/bin.cjs --site site/dist --glob \"**/index.html\"",
    "site:build:pagefind:workspace": "node .codex/hooks/run-workspace-pagefind.mjs",
    "site:build:full": "npm run site:build:astro && npm run site:build:pagefind",
    "site:build:workspace-pagefind": "node --env-file=site-build.properties .codex/hooks/site-build-if-changed.mjs --generate --workspace-pagefind",
    "check:workspace-pagefind": "npm run site:build:workspace-pagefind && npm run check:pagefind-contract && npm run check:search-ranking && npm run check:rendered-video-dates",
    "check:pagefind-contract": "tsx src/scripts/check-pagefind-contract.ts",
    "check:search-ranking": "tsx src/scripts/check-search-ranking.ts",
    "check:rendered-video-dates": "tsx src/scripts/check-rendered-video-dates.ts",
    "check:site-seo": "npm run build && npm run check:site-seo:built",
    "check:site-seo:built": "node --env-file=site-build.properties dist/scripts/check-site-seo.js",
    "preaudit:lighthouse:home": "node -e \"require('fs').mkdirSync('reports/lighthouse', { recursive: true })\"",
    "audit:lighthouse:home": "lighthouse https://r-jack-ray.github.io/naval-history-with-dr-alex/ --output=html --output=json --output-path=reports/lighthouse/home --chrome-flags=\"--headless\"",
    "preaudit:lighthouse:local": "node -e \"require('fs').mkdirSync('reports/lighthouse', { recursive: true })\"",
    "audit:lighthouse:local": "lighthouse http://127.0.0.1:4321/naval-history-with-dr-alex/ --output=html --output=json --output-path=reports/lighthouse/local-home --chrome-flags=\"--headless\"",
    "audit:lighthouse:seo-baseline": "tsx src/scripts/audit-seo-lighthouse.ts"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/sitemap": "^3.7.3",
    "@types/node": "^22.10.0",
    "astro": "^7.0.6",
    "htmlparser2": "^12.0.0",
    "lighthouse": "^13.4.0",
    "pagefind": "^1.5.2",
    "puppeteer-core": "^25.3.0",
    "saxes": "^6.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "youtube-transcript-plus": "^2.0.0",
    "zod": "^4.4.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
